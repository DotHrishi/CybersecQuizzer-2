datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Question {
  id            Int      @id @default(autoincrement())
  scenario      String?  // Optional situational / context background text
  questionText  String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String   // "A", "B", "C", or "D"
  category      String   @default("General Security")
  difficulty    String   @default("Medium") // "Easy", "Medium", "Hard"
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("questions")
}

model UserAttempt {
  id             Int      @id @default(autoincrement())
  userName       String
  quizDate       String   // Format: "YYYY-MM-DD"
  isCorrect      Boolean
  score          Int      // Base score: 1 if correct, 0 if wrong
  bonusPoints    Int      // Speed bonus: 10, 8, 6, 4, 2, 1, 0
  totalPoints    Int      // score + bonusPoints
  responseTimeMs Int      // Milliseconds taken to respond
  category       String?  @default("General Security")
  createdAt      DateTime @default(now())

  @@index([userName])
  @@index([quizDate])
  @@index([userName, quizDate])
  @@map("user_attempts")
}

model College {
  id          Int                 @id @default(autoincrement())
  name        String              @unique
  identifier  String              @unique
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  departments CollegeDepartment[]
  admins      AdminUser[]
  students    UserProfile[]

  @@map("colleges")
}

model CollegeDepartment {
  id              Int           @id @default(autoincrement())
  collegeId       Int
  college         College       @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  departmentName  String
  registrationKey String        @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  students        UserProfile[]
  admins          AdminUser[]

  @@unique([collegeId, departmentName])
  @@index([collegeId])
  @@index([registrationKey])
  @@map("college_departments")
}

model UserProfile {
  id                  Int                @id @default(autoincrement())
  fullName            String
  nickname            String             @unique
  isNicknameSame      Boolean            @default(false)
  email               String
  emailType           String             @default("college") // "college" or "personal"
  collegeId           Int?
  college             College?           @relation(fields: [collegeId], references: [id])
  collegeDepartmentId Int?
  collegeDepartment   CollegeDepartment? @relation(fields: [collegeDepartmentId], references: [id])
  passwordHash        String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([nickname])
  @@index([email])
  @@index([collegeId])
  @@index([collegeDepartmentId])
  @@map("user_profiles")
}

model AdminUser {
  id                  Int                @id @default(autoincrement())
  email               String             @unique
  passwordHash        String
  name                String?
  active              Boolean            @default(true)
  collegeId           Int?
  college             College?           @relation(fields: [collegeId], references: [id])
  collegeDepartmentId Int?
  collegeDepartment   CollegeDepartment? @relation(fields: [collegeDepartmentId], references: [id])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([email])
  @@index([collegeId])
  @@index([collegeDepartmentId])
  @@map("admin_users")
}
